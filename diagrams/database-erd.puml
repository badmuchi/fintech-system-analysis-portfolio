@startuml
!theme plain
hide circle
skinparam linetype ortho

entity "users" as users {
  * id : UUID <<PK>>
  --
  * email : VARCHAR(255) <<UNIQUE>>
  * phone : VARCHAR(20) <<UNIQUE>>
  * status : VARCHAR(32)
  * created_at : TIMESTAMPTZ
}

entity "accounts" as accounts {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * account_number : VARCHAR(34) <<UNIQUE>>
  * currency : VARCHAR(3)
  * balance : NUMERIC(15, 2)
  * hold_amount : NUMERIC(15, 2)
  * status : VARCHAR(32)
  * created_at : TIMESTAMPTZ
}

entity "transfers" as transfers {
  * id : UUID <<PK>>
  --
  * idempotency_key : UUID <<UNIQUE>>
  * source_account_id : UUID <<FK>>
  * target_account_id : UUID <<FK>>
  * amount : NUMERIC(15, 2)
  * currency : VARCHAR(3)
  * status : VARCHAR(32)
  * external_gateway_id : VARCHAR(64)
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
}

entity "account_entries" as entries {
  * id : UUID <<PK>>
  --
  * transfer_id : UUID <<FK>>
  * account_id : UUID <<FK>>
  * entry_type : VARCHAR(16)
  * amount : NUMERIC(15, 2)
  * created_at : TIMESTAMPTZ
}

users ||--o{ accounts : "has"
accounts ||--o{ transfers : "source"
accounts ||--o{ transfers : "target"
transfers ||--|{ entries : "generates"
accounts ||--o{ entries : "contains"
@enduml